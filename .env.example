# Phase 2 local development (optional)
VITE_CLOUD_ENABLED=true
VITE_API_BASE_URL=http://localhost:3000

# Public Google OAuth client ID (safe to expose in the browser for Picker)
# VITE_GOOGLE_CLIENT_ID=

# Set true for CI / Playwright without real Google credentials
# VITE_DRIVE_MOCK=true

# Playwright Phase 2 e2e — starts docker compose automatically
# PHASE2_DOCKER=true

# Skip docker auto-start if API is already running
# PHASE2_SKIP_DOCKER=true

# --- API / Docker (never commit real secrets; use .env.local) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# FRONTEND_ORIGIN=http://localhost:5173
# GOOGLE_MOCK=true
